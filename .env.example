# Backend
DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# LLM (opsional, hanya untuk teks saran; skor tetap dihitung kode)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20

# Postgres untuk docker-compose
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=careerlens
POSTGRES_DB=careerlens
