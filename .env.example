# ---------------------------------------------------------------------------
# CareerLens AI — contoh konfigurasi environment
# Salin menjadi .env lalu ganti semua nilai rahasia. Jangan commit .env.
# ---------------------------------------------------------------------------

# development | production
# Di production, aplikasi menolak start jika JWT_SECRET masih nilai contoh
# atau kurang dari 32 karakter.
ENVIRONMENT=development

# Backend
DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Wajib JSON array; jangan gunakan "*" di production.
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=10
BCRYPT_ROUNDS=12

# Upload CV
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# LLM (opsional, hanya untuk teks saran; skor tetap dihitung kode)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20

# Postgres untuk docker-compose (ganti untuk deployment)
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=careerlens
POSTGRES_DB=careerlens

# Frontend (dipakai saat build/dev Vite)
VITE_API_URL=http://localhost:8000
